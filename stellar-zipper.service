[Unit]
Description=Zip ingested Steam workshop snapshots (complete/ -> under_zip/ -> archive_steam_workshop_data/)

[Service]
ExecStart=/zpool0/share/stellar-mods/zip_completed.sh
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
