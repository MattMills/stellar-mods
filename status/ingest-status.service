[Unit]
Description=Steam workshop ingest status page (/ingest-status/), rewritten every 5 s
After=postgresql.service

[Service]
ExecStart=/usr/bin/python3 /zpool0/share/stellar-mods/status/ingest_status.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Nice=19
IOSchedulingClass=idle
CPUQuota=50%

[Install]
WantedBy=multi-user.target
